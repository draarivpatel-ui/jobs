{
  "port": 4000,
  "dependsOn": [
    "jobs"
  ],
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "dev": {
    "command": "bun run dev",
    "watch": [
      "src/**/*"
    ]
  },
  "healthCheckPath": "/health",
  "$schema": "https://flisk.sh/schema.service.json",
  "schemaVersion": 1,
  "appName": "bot",
  "appType": "agent",
  "featuresEnabled": [],
  "name": "bot",
  "type": "agent",
  "stack": "bot",
  "agent": {
    "runtime": "custom",
    "durability": "files"
  },
  "params": {
    "JOBS_URL": "http://jobs:4001",
    "BOT_NAME": "Flisk Bot",
    "BOT_POLL_SECONDS": "10",
    "JOBS_PUBLIC_URL": "http://api.flisk-bot.localhost:8082/api/jobs"
  }
}
