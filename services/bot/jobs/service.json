{
  "port": 4001,
  "dependsOn": [
    "jobs-db"
  ],
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "dev": {
    "command": "bun run dev",
    "watch": [
      "src/**/*"
    ]
  },
  "healthCheckPath": "/health",
  "$schema": "https://flisk.sh/schema.service.json",
  "schemaVersion": 1,
  "appName": "jobs",
  "appType": "backend",
  "featuresEnabled": [],
  "name": "jobs",
  "type": "backend",
  "stack": "bot",
  "params": {
    "JOBS_DB": "/app/data/jobs.db"
  }
}
